{
  "info": {
    "name": "Kafka Lag Autoscaler Postman Collection",
    "description": "Intelligent autoscaling for Kafka consumer groups based on real-time lag, \nthroughput, and predicted workload. Scales consumer pods up within seconds \nof lag spikes, scales down gracefully after catch-up, and respects peak \nhours, cost budgets, and per-topic scaling limits. Eliminates the classic \n\"consumer lag built up overnight because nobody was watching\" scenario \nwhile preventing runaway consumer sprawl that inflates cloud bills.\n\nOpenAPI version: 3.0.3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://kafka-autoscaler.forgesphere.lightning.com/v1",
      "type": "string",
      "description": "Override with the base URL of the deployed Kong gateway."
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "clusterName",
      "value": "",
      "type": "string",
      "description": "Filter by Kafka cluster."
    },
    {
      "key": "namespace",
      "value": "",
      "type": "string",
      "description": "Filter by Kubernetes namespace."
    },
    {
      "key": "owner",
      "value": "",
      "type": "string",
      "description": "Filter by owning team."
    },
    {
      "key": "status",
      "value": "",
      "type": "string",
      "description": "Filter by autoscaler status."
    },
    {
      "key": "hasHighLag",
      "value": "",
      "type": "string",
      "description": "Only show autoscalers currently above their scale-up threshold."
    },
    {
      "key": "atMaxReplicas",
      "value": "",
      "type": "string",
      "description": "Only show autoscalers running at maxReplicas (potentially under-scaled)."
    },
    {
      "key": "sortBy",
      "value": "",
      "type": "string",
      "description": "Sort order."
    },
    {
      "key": "page",
      "value": "",
      "type": "string",
      "description": "Page number (zero-based)."
    },
    {
      "key": "size",
      "value": "",
      "type": "string",
      "description": "Number of items per page."
    },
    {
      "key": "autoscalerId",
      "value": "",
      "type": "string",
      "description": "Unique identifier of the autoscaler."
    },
    {
      "key": "includeScalingHistory",
      "value": "",
      "type": "string",
      "description": "Include last 50 scaling events."
    },
    {
      "key": "includePartitionLag",
      "value": "",
      "type": "string",
      "description": "Include per-partition lag breakdown (useful for hotspot detection)."
    }
  ],
